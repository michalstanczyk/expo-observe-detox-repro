+  /// Concrete forwarders for the completion callbacks that tools which dynamically subclass session
+  /// delegates (Detox's `__detox_sync_URLSessionDelegateProxy`) re-dispatch to `super`. They gate
+  /// that call on `+instancesRespondToSelector:`, a class-level check that never consults
+  /// `forwardingTarget(for:)`, so without these the wrapped delegate never learns its task finished
+  /// and every request hangs. `responds(to:)` still mirrors the wrapped delegate, so `URLSession`
+  /// itself only calls these when the wrapped delegate implements them.
+  ///
+  /// Dispatch goes through the Obj-C runtime rather than a Swift protocol cast, like `URLSession`
+  /// does: delegates such as expo-file-system's `EXSessionTaskDispatcher` implement these
+  /// selectors while declaring only `NSURLSessionDelegate`, so `as? URLSessionTaskDelegate` fails.
+  @objc(URLSession:task:didCompleteWithError:)
+  func urlSession(_ session: URLSession, task: URLSessionTask, didCompleteWithError error: Error?) {
+    guard let target = wrapped as? NSObject, target.responds(to: Self.didCompleteSelector) else {
+      return
+    }
+    typealias DidComplete = @convention(c) (AnyObject, Selector, URLSession, URLSessionTask, NSError?) -> Void
+    let implementation = unsafeBitCast(target.method(for: Self.didCompleteSelector), to: DidComplete.self)
+    implementation(target, Self.didCompleteSelector, session, task, error as NSError?)
+  }
+
+  @objc(URLSession:dataTask:didReceiveResponse:completionHandler:)
+  func urlSession(
+    _ session: URLSession,
+    dataTask: URLSessionDataTask,
+    didReceive response: URLResponse,
+    completionHandler: @escaping (URLSession.ResponseDisposition) -> Void
+  ) {
+    guard let target = wrapped as? NSObject, target.responds(to: Self.didReceiveResponseSelector) else {
+      completionHandler(.allow)
+      return
+    }
+    typealias DidReceiveResponse = @convention(c) (
+      AnyObject,
+      Selector,
+      URLSession,
+      URLSessionDataTask,
+      URLResponse,
+      @escaping @convention(block) (URLSession.ResponseDisposition) -> Void
+    ) -> Void
+    let implementation = unsafeBitCast(target.method(for: Self.didReceiveResponseSelector), to: DidReceiveResponse.self)
+    implementation(target, Self.didReceiveResponseSelector, session, dataTask, response) { completionHandler($0) }
+  }
+
